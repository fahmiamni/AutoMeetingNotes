# AutoMeetingNotes configuration template.
# Copy to .env and fill in your values. Never commit .env.

# ── Input ────────────────────────────────────────────────────────────────────
# Host folder containing meeting audio files (.mp3, .m4a, .wav, .ogg, .mp4).
# Mounted into the transcriber container at /app/input.
# For docker-compose this must be an absolute host path, e.g.:
#   INPUT_DIR=G:\My Drive
INPUT_DIR=./input

# ── Transcription ────────────────────────────────────────────────────────────
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=large-v3-turbo
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_CPU_THREADS=4
# WHISPER_BEAM_SIZE=5
# WHISPER_CHUNK_SECONDS=30
# WHISPER_OVERLAP_SECONDS=5

# ── Summarization (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=google/gemini-3-flash-preview
# SUMMARY_MAX_TOKENS=30000
# OPENROUTER_TIMEOUT_SECONDS=180

# ── OneNote saving (Maton API) ───────────────────────────────────────────────
MATON_API_KEY=your_key_here
ONENOTE_NOTEBOOK_NAME=your_notebook_name
ONENOTE_SECTION_NAME=Meeting
